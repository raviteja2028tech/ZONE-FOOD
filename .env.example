# ZoneFood local development configuration.
# Copy to `.env` and change the placeholder passwords. `.env` is git-ignored.
# These are LOCAL-ONLY credentials for the Docker databases; never reuse real passwords.

# --- PostgreSQL 16 + pgvector ---
POSTGRES_USER=zonefood
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=zonefood
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# --- MongoDB 7 ---
MONGO_INITDB_ROOT_USERNAME=zonefood
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo
MONGO_DB=zonefood
MONGO_HOST=127.0.0.1
MONGO_PORT=27018

# Python scripts (scripts/db_config.py) AND the Next.js app (src/lib/env/server.ts) read the SAME variables above;
# Next.js loads .env automatically. Hosts/ports/MONGO_DB have safe defaults; the user/password/database values do not,
# and a missing one produces a clear setup error.
# Optional: LOG_LEVEL=debug|info|warn|error (default info)


# --- Seed script ---
# Shared password for the synthetic demo accounts created by scripts/seed.py (LOCAL DEMO ONLY).
DEMO_USER_PASSWORD=change_me_demo_password

# --- Web app (Part 2) ---
# Signs session cookies (HS256). Required, >= 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change_me_to_a_long_random_string_of_at_least_32_chars
# true shows the demo-account emails (never the password) on the login page. Set false for anything shared.
DEMO_LOGIN_HINTS=true
