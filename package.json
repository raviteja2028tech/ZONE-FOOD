{
  "name": "zonefood",
  "version": "0.1.0",
  "private": true,
  "description": "ZoneFood - food resource management DBMS mini-project (Next.js app)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "demo:prepare": "tsx --tsconfig tsconfig.scripts.json scripts-web/prepare-demo.ts",
    "test:all": "python scripts/run_all_tests.py",
    "docs:generate": "python scripts/gen_part3_docs.py"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "bcryptjs": "^3.0.3",
    "geist": "^1.9.0",
    "jose": "^6.2.14",
    "lucide-react": "^1.66.0",
    "mongodb": "^7.8.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "^16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
